####### Compile

obj/AAFilter.o: AAFilter.cpp AAFilter.h \
		STTypes.h \
		FIRFilter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/AAFilter.o AAFilter.cpp

obj/FIRFilter.o: FIRFilter.cpp FIRFilter.h \
		STTypes.h \
		cpu_detect.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/FIRFilter.o FIRFilter.cpp

obj/FIFOSampleBuffer.o: FIFOSampleBuffer.cpp FIFOSampleBuffer.h \
		FIFOSamplePipe.h \
		STTypes.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/FIFOSampleBuffer.o FIFOSampleBuffer.cpp

obj/RateTransposer.o: RateTransposer.cpp RateTransposer.h \
		AAFilter.h \
		STTypes.h \
		FIFOSamplePipe.h \
		FIFOSampleBuffer.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/RateTransposer.o RateTransposer.cpp

obj/SoundTouch.o: SoundTouch.cpp SoundTouch.h \
		FIFOSamplePipe.h \
		STTypes.h \
		TDStretch.h \
		RateTransposer.h \
		AAFilter.h \
		FIFOSampleBuffer.h \
		cpu_detect.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/SoundTouch.o SoundTouch.cpp

obj/TDStretch.o: TDStretch.cpp STTypes.h \
		cpu_detect.h \
		TDStretch.h \
		RateTransposer.h \
		AAFilter.h \
		FIFOSamplePipe.h \
		FIFOSampleBuffer.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/TDStretch.o TDStretch.cpp

obj/cpu_detect_x86_gcc.o: cpu_detect_x86_gcc.cpp cpu_detect.h \
		STTypes.h \
		../../config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/cpu_detect_x86_gcc.o cpu_detect_x86_gcc.cpp

obj/sse_gcc.o: sse_gcc.cpp STTypes.h \
		TDStretch.h \
		RateTransposer.h \
		AAFilter.h \
		FIFOSamplePipe.h \
		FIFOSampleBuffer.h \
		FIRFilter.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/sse_gcc.o sse_gcc.cpp

